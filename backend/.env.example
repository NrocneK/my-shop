# ============================================================
# backend/.env.example  [V9]
# Copy file này thành .env và điền giá trị thật
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bag_store

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Thư mục upload ảnh
UPLOAD_DIR=uploads

# Frontend URL (cho CORS)
CLIENT_URL=http://localhost:3000

# Email (Gmail App Password)
# Vào myaccount.google.com > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=BagStore <your_email@gmail.com>
ADMIN_EMAIL=admin@bagstore.vn

# URLs
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ─── THANH TOÁN NGÂN HÀNG ────────────────────────────────────
# Thông tin tài khoản ngân hàng nhận thanh toán
# Danh sách mã ngân hàng: https://api.vietqr.io/v2/banks
BANK_ID=MB              # Mã ngân hàng (MB, VCB, TCB, ACB, BIDV, CTG, VPB, TPB...)
BANK_ACCOUNT=9999999999 # Số tài khoản
BANK_NAME=NGUYEN VAN A  # Tên chủ tài khoản (VIẾT HOA, KHÔNG DẤU)

# ─── MOMO SANDBOX ──────────────────────────────────────────
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
